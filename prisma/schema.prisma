
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  PROVIDER
  SUPER_ADMIN
}

model Role {
  id        String    @id @default(uuid())
  name      UserRole  @unique
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  users     User[]

  @@index([deletedAt])
  @@map("roles")
}

model User {
  id            String         @id @default(uuid())
  phoneNumber   String?        @unique @map("phone_number")
  email         String?        @unique
  password      String?
  name          String?
  avatarUrl     String?        @map("avatar_url")
  avatarPublicId String?       @map("avatar_public_id")
  roleId        String?        @map("role_id")
  role          Role?          @relation(fields: [roleId], references: [id])
  bookings      Booking[]
  vendorProfile VendorProfile?
  customerProfile CustomerProfile?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  deletedAt     DateTime?      @map("deleted_at")

  @@index([roleId])
  @@index([deletedAt])
  @@map("users")
}


model VendorProfile {
  id             String    @id @default(uuid())
  userId         String    @unique @map("user_id")
  user           User      @relation(fields: [userId], references: [id])
  businessName   String    @map("business_name")
  imageUri       String?   @map("image_uri")
  gstNumber      String?   @map("gst_number")
  contactNumber  String?   @map("contact_number")
  address        String?
  serviceRadius  String?   @map("service_radius") // e.g. "5km", "10km", "25km"
  operatingHours String?   @map("operating_hours")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")
  bankDetails    VendorBankDetails?
  services       Service[]
  availability   VendorAvailability[]
  breaks         VendorBreak[]
  exceptions     VendorException[]

  @@index([userId])
  @@index([deletedAt])
  @@map("vendor_profiles")
}

model VendorAvailability {
  id              String        @id @default(uuid())
  vendorProfileId String        @map("vendor_profile_id")
  vendorProfile   VendorProfile @relation(fields: [vendorProfileId], references: [id])
  dayOfWeek       Int // 0 (Sunday) to 6 (Saturday)
  startTime       String // HH:mm format
  endTime         String // HH:mm format
  isActive        Boolean       @default(true) @map("is_active")

  @@unique([vendorProfileId, dayOfWeek])
  @@map("vendor_availability")
}

model VendorBreak {
  id              String        @id @default(uuid())
  vendorProfileId String        @map("vendor_profile_id")
  vendorProfile   VendorProfile @relation(fields: [vendorProfileId], references: [id])
  name            String
  startTime       String // HH:mm
  endTime         String // HH:mm

  @@map("vendor_breaks")
}

enum ExceptionType {
  BLOCKED_OUT
  SHORTENED_HOURS
}

model VendorException {
  id              String        @id @default(uuid())
  vendorProfileId String        @map("vendor_profile_id")
  vendorProfile   VendorProfile @relation(fields: [vendorProfileId], references: [id])
  date            DateTime      @db.Date
  description     String?
  type            ExceptionType
  startTime       String? // Nullable if BLOCKED_OUT
  endTime         String? // Nullable if BLOCKED_OUT

  @@unique([vendorProfileId, date])
  @@map("vendor_exceptions")
}

model VendorBankDetails {
  id              String        @id @default(uuid())
  vendorProfileId String        @unique @map("vendor_profile_id")
  vendorProfile   VendorProfile @relation(fields: [vendorProfileId], references: [id])
  accountHolder   String        @map("account_holder")
  bankName        String        @map("bank_name")
  ifscCode        String        @map("ifsc_code")
  accountNumber   String        @map("account_number")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  deletedAt       DateTime?     @map("deleted_at")

  @@index([vendorProfileId])
  @@index([deletedAt])
  @@map("vendor_bank_details")
}


model Service {
  id              String         @id @default(uuid())
  vendorProfileId String         @map("vendor_profile_id")
  vendorProfile   VendorProfile  @relation(fields: [vendorProfileId], references: [id])
  name            String
  description     String?
  price           Float
  duration        Int // duration in minutes
  location        String?
  features        String[]       @default([])
  images          String[]       @default([])
  bookings        Booking[]
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  deletedAt       DateTime?      @map("deleted_at")

  @@index([vendorProfileId])
  @@index([deletedAt])
  @@map("services")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Booking {
  id          String        @id @default(uuid())
  userId      String        @map("user_id")
  user        User          @relation(fields: [userId], references: [id])
  serviceId   String        @map("service_id")
  service     Service       @relation(fields: [serviceId], references: [id])
  status      BookingStatus @default(PENDING)
  scheduledAt DateTime      @map("scheduled_at")
  review      Review?
  dispute     Dispute?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  deletedAt   DateTime?     @map("deleted_at")

  @@index([userId])
  @@index([serviceId])
  @@index([status])
  @@index([deletedAt])
  @@map("bookings")
}

model Review {
  id        String    @id @default(uuid())
  bookingId String    @unique @map("booking_id")
  booking   Booking   @relation(fields: [bookingId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([bookingId])
  @@index([rating])
  @@index([deletedAt])
  @@map("reviews")
}

model Dispute {
  id        String    @id @default(uuid())
  bookingId String    @unique @map("booking_id")
  booking   Booking   @relation(fields: [bookingId], references: [id])
  reason    String
  status    String    @default("OPEN")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([bookingId])
  @@index([status])
  @@index([deletedAt])
  @@map("disputes")
}

model Verification {
  id          String    @id @default(uuid())
  phoneNumber String    @map("phone_number")
  code        String
  expiresAt   DateTime  @map("expires_at")
  isUsed      Boolean   @default(false) @map("is_used")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@index([phoneNumber, code])
  @@index([deletedAt])
  @@map("verifications")
}

model HeroContent {
  id        String   @id @default(uuid())
  slide1Url String?  @map("slide1_url")
  slide2Url String?  @map("slide2_url")
  slide3Url String?  @map("slide3_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("hero_contents")
}

model ServiceCategory {
  id        String    @id @default(uuid())
  name      String
  icon      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([deletedAt])
  @@map("service_categories")
}

model CustomerProfile {
  id             String            @id @default(uuid())
  userId         String            @unique @map("user_id")
  user           User              @relation(fields: [userId], references: [id])
  name           String
  phone          String
  email          String?
  location       String?
  addresses      CustomerAddress[]
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  deletedAt      DateTime?         @map("deleted_at")

  @@index([userId])
  @@index([deletedAt])
  @@map("customer_profiles")
}

model CustomerAddress {
  id                String          @id @default(uuid())
  customerProfileId String          @map("customer_profile_id")
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id])
  label             String
  street            String
  city              String
  state             String
  zipCode           String          @map("zip_code")
  type              String // 'home' | 'work' | 'office'
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  deletedAt         DateTime?       @map("deleted_at")

  @@index([customerProfileId])
  @@index([deletedAt])
  @@map("customer_addresses")
}

